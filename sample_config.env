# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

